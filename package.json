{
  "name": "ai-desktop-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "hutch dev",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build:native": "./scripts/build-native.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/bun src/renderer src/shared",
    "test": "bun test ./tests",
    "build": "hutch run build",
    "build:stable": "hutch run build:stable"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "bun-types": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "^2",
    "lucide-react": "^1.72.0",
    "oxlint": "^1.25.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
