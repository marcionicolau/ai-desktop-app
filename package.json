{
  "name": "ai-desktop-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash -c 'trap \"bun run kill-dev >/dev/null 2>&1\" EXIT; bun run dev:devtools & hutch dev & dev_pid=$!; until pgrep -f \"[A]IDesktopApp\" >/dev/null || ! kill -0 \"$dev_pid\" 2>/dev/null; do sleep 1; done; while pgrep -f \"[A]IDesktopApp\" >/dev/null; do sleep 1; done'",
    "dev:devtools": "react-devtools",
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build:native": "./scripts/build-native.sh",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/bun src/renderer src/shared",
    "test": "bun test ./tests",
    "build": "hutch run build",
    "build:stable": "RELEASE_CHANNEL=stable hutch run build:stable",
    "kill": "pkill -f \"[A]IDesktopApp\" || true; pkill -f \"[r]eact-devtools\" || true",
    "kill-dev": "bun run kill; pkill -f \"$PWD/[n]ode_modules/\" || true; pkill -f \"[h]utch-engine (dev|electrobun dev|pm exec)\" || true",
    "package": "scripts/build-native.sh && bun run build:renderer && bun run build && for d in build/canary-*; do scripts/verify-artifact.sh \"$d\"; done",
    "package:stable": "scripts/build-native.sh && bun run build:renderer && bun run build:stable && for d in build/stable-*; do scripts/verify-artifact.sh \"$d\"; done",
    "release:status": "bun scripts/release.ts status",
    "release:stag": "bun scripts/release.ts stag",
    "release:prod": "bun scripts/release.ts prod"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "bun-types": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "^2",
    "lucide-react": "^1.72.0",
    "oxlint": "^1.25.0",
    "react-devtools": "^8.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
